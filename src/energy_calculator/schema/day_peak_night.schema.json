{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "day_peak_night.schema.json",
    "title": "day_peak_night",
    "description": "A day,peak,night electricty rate outline",
    "type": "object",
    "properties": {
        "costing_type": {
            "type":"string"
        },
        "rates": {
            "type":"object",
            "properties": {
                "day": {
                    "type":"number"
                },
                "peak": {
                    "type":"number"
                },
                "night":  {
                    "type":"number"
                },
                "export": {
                    "type":"number"
                }
            },
            "required": ["day", "night", "peak"]
        }
    },
    "required": ["rates", "costing_type"]
}
