{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "24hr.schema.json",
    "title": "24hr",
    "description": "A 24hr electricty rate outline",
    "type": "object",
    "properties": {
        "costing_type": {
            "type":"string"
        },
        "rates": {
            "type":"object",
            "properties": {
                "import": {
                    "type":"number"
                },
                "export": {
                    "type":"number"
                }
            },
            "required": ["import"]
        }
    },
    "required": ["rates", "costing_type"]
}
